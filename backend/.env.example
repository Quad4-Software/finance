DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/quad4
SECRET_KEY=change-me-in-production
DEBUG=true
FRONTEND_URL=http://localhost:5173
REDIS_URL=redis://localhost:6379/0

# Kernel sandboxing (Landlock + seccomp denylist). Applied at process start;
# no-ops on kernels without support. See app/core/sandbox.py.
SANDBOX_ENABLED=true
SANDBOX_LANDLOCK_ENABLED=true
SANDBOX_SECCOMP_ENABLED=true

# Storage backend: "local" or "s3"
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/attachments
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_ENDPOINT_URL=

# Scheduled encrypted backups (daily, to the storage provider)
BACKUP_LOCAL_PATH=./data/backups
# BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_COUNT=14
BACKUP_SCHEDULE_HOUR=3

# Number of trusted reverse proxies in front of the backend (the bundled nginx
# frontend counts as 1). Rate limiting keys requests by client IP; leaving this
# at 0 in a proxied deployment means every client shares one rate-limit bucket.
TRUSTED_PROXY_HOPS=0

# Optional OIDC login (Authentik, Pocket ID, or standard OIDC providers)
OIDC_ENABLED=false
OIDC_PROVIDER_NAME=OIDC
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Defaults to ${FRONTEND_URL}/api/auth/oidc/callback
OIDC_REDIRECT_URI=
# Quoted on purpose: values with spaces must be quoted for deploy scripts
# that source this file with a shell. Compose and the backend strip the quotes.
OIDC_SCOPES="openid email profile"
OIDC_AUTO_REGISTER=true
OIDC_REQUIRE_VERIFIED_EMAIL=true
# Set to false only with OIDC_ENABLED=true, OIDC_CLIENT_ID, and OIDC_DISCOVERY_URL configured
LOCAL_AUTH_ENABLED=true
OIDC_SYNC_ROLES=false
OIDC_ROLES_CLAIM=groups
OIDC_ADMIN_ROLES=
OIDC_WORKSPACE_ROLE_MAP=
