# Required
SECRET_KEY=change-me-in-production

# Bank sync: Enable Banking (https://enablebanking.com) for European banks
## 1. Sign up at https://enablebanking.com and create a Production application
## 2. Add http://localhost:${FRONTEND_PORT}/oauth/callback as an allowed redirect URL
## 3. Save the downloaded PEM file to ./secrets/enable_banking_private.pem
## 4. Copy your Application ID below
ENABLE_BANKING_APP_ID=
# Override only if you put the PEM somewhere other than the default below
# ENABLE_BANKING_PRIVATE_KEY_FILE=/app/secrets/enable_banking_private.pem
# Defaults to ${FRONTEND_URL}/oauth/callback. Set it only when the URL you
# registered in your EB application differs from where the app is served.
# ENABLE_BANKING_OAUTH_REDIRECT_URI=https://quad4.example.com/oauth/callback

# OIDC login (optional): Authentik, Pocket ID, or any standard OIDC provider
## Redirect/callback URL to register in the provider:
##   http://localhost:${FRONTEND_PORT:-3000}/api/auth/oidc/callback
# OIDC_ENABLED=true
# OIDC_PROVIDER_NAME="My SSO"
# OIDC_DISCOVERY_URL=https://id.example.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=quad4
# OIDC_CLIENT_SECRET=your-client-secret
# Quoted on purpose: values with spaces must be quoted for deploy scripts
# that source this file with a shell. Compose and the backend strip the quotes.
# OIDC_SCOPES="openid email profile"
# OIDC_AUTO_REGISTER=true
# OIDC_REQUIRE_VERIFIED_EMAIL=true
# Optional: require OIDC-only login; requires OIDC_ENABLED, OIDC_CLIENT_ID, and OIDC_DISCOVERY_URL
# Disables local login, registration, password reset/change, and new passkey ceremonies
# LOCAL_AUTH_ENABLED=false
# Link an OIDC login to an existing Quad4 Finance account with the same email:
#   disabled (default) never links, verified_email links only when the provider
#   sends email_verified=true, email links on a matching email alone.
# OIDC_EXISTING_USER_LINK_MODE=disabled
# Optional: sync Quad4 Finance admin/workspace roles from OIDC roles/groups
# OIDC_SYNC_ROLES=true
# OIDC_ROLES_CLAIM=groups
# OIDC_ADMIN_ROLES=quad4-admins
# OIDC_WORKSPACE_ROLE_MAP={"quad4-owners":"owner","quad4-editors":"editor","quad4-viewers":"viewer"}

# Kernel sandbox (optional). Landlock filesystem isolation and a seccomp
# syscall denylist are applied by the backend, worker and beat processes at
# startup. They need no extra privileges and disable themselves on kernels
# without support. All default to true in docker-compose.prod.yml.
# SANDBOX_ENABLED=false
# SANDBOX_LANDLOCK_ENABLED=false
# SANDBOX_SECCOMP_ENABLED=false

# Storage (optional). Defaults to local disk under /app/data. Set
# STORAGE_PROVIDER=s3 to put attachments and backups on S3-compatible
# object storage (AWS S3, MinIO, Cloudflare R2, Backblaze B2).
# STORAGE_PROVIDER=s3
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# Custom endpoint for non-AWS S3 services, e.g. https://minio.example.com
# STORAGE_S3_ENDPOINT_URL=

# Scheduled backups (optional). A daily job writes an AES-256 encrypted
# archive per workspace to the storage provider under backups/, keeping the
# newest BACKUP_RETENTION_COUNT archives. The encryption key defaults to one
# derived from SECRET_KEY; set a dedicated key to keep backups decryptable
# after rotating SECRET_KEY.
# BACKUP_ENCRYPTION_KEY=
# BACKUP_RETENTION_COUNT=14
# BACKUP_SCHEDULE_HOUR=3

# Passkeys (optional). Nothing to set for the common cases.
## Passkeys follow the address you open the app on, so they work out of the box on
## http://localhost:3000 and on any HTTPS domain behind a reverse proxy.
##
## Two limits come from the WebAuthn standard itself, not from Quad4 Finance:
##   - an IP address (http://192.168.1.10:3000) can never be used for passkeys
##   - plain HTTP can never be used, except on localhost
## Reach the app on a domain over HTTPS, or on http://localhost, to use passkeys.
##
## Set FRONTEND_URL when the app is served from a domain; it is also used for
## CORS and OAuth callbacks.
# FRONTEND_URL=https://quad4.example.com
##
## Optional: pin passkeys to a single domain. Leave unset to follow the browser.
## Set it to the parent domain if you reach the app on several subdomains.
# WEBAUTHN_RP_ID=quad4.example.com
## Optional: the name shown in the browser's passkey prompt.
# WEBAUTHN_RP_NAME=Quad4 Finance

# Timezone (optional). Calendar dates follow the timezone saved in Admin
## Settings; without one, this variable, then the host timezone, then UTC.
# TZ=UTC

# Host ports (optional). Change these to avoid conflicts with other services
## Default values are set in docker-compose.yml and docker-compose.prod.yml.
## Example:
# FRONTEND_PORT=3132
# BACKEND_PORT=8182

# Reverse proxy labels (optional, docker-compose.prod.yml only): static
# Traefik routing labels on the frontend service, for setups (e.g. some
# Coolify versions) where the proxy's own domain UI doesn't turn into
# working Traefik labels on this compose file. Off by default.
# TRAEFIK_ENABLE=true
# FRONTEND_DOMAIN=quad4.example.com
## Set to a network name shared by this stack and your Traefik/proxy
## container. Find it with `docker network ls` or `docker inspect
## <traefik-container> --format '{{json .NetworkSettings.Networks}}'`.
## Leave unset to let Traefik auto-detect the shared network; it works as
## long as `frontend` is on exactly one network (the default). REQUIRED if
## you've attached `frontend` to more than one network yourself.
# TRAEFIK_NETWORK=
## Only if your ACME resolver isn't named "letsencrypt".
# TRAEFIK_CERTRESOLVER=letsencrypt
## Must be unique per deployment if multiple Quad4 Finance instances share the
## same Traefik/Coolify proxy; otherwise their router/service names collide.
# TRAEFIK_RESOURCE_NAME=quad4-frontend

# AI Agents (optional). To enable, set BOTH:
#   1) the feature flag
#   2) COMPOSE_PROFILES so `docker compose up` starts the mcp-server container
#      (Docker Compose only. On a bare-metal/LXC install set just the flag,
#      run `uvicorn mcp_server.main:app --port 8765` next to the API, and set
#      AGENTS_BUILTIN_MCP_URL=http://127.0.0.1:8765/mcp)
# AGENTS_ENABLED=true
# COMPOSE_PROFILES=agents
# Public URL external agents use to reach the built-in MCP server, shown in the
# UI token panel. Leave unset to derive it from the browser (host:8765). Set it
# when the MCP server is exposed behind an ingress/reverse proxy on a custom
# host, subpath, or standard 80/443 port instead of :8765.
# AGENTS_EXTERNAL_MCP_URL=https://quad4.example.com/mcp